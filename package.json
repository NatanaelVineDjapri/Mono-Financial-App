{
  "name": "mono-finance",
  "version": "1.0.0",
  "main": "expo-router/entry",
  "dependencies": {
    "@expo-google-fonts/ibm-plex-mono": "^0.4.1",
    "@expo-google-fonts/ibm-plex-sans": "^0.4.1",
    "@expo-google-fonts/newsreader": "^0.4.1",
    "@expo/ui": "~58.0.26",
    "@react-native-ml-kit/text-recognition": "^2.0.0",
    "@shopify/react-native-skia": "2.14.0",
    "@tanstack/react-query": "^5.106.1",
    "expo": "~58.0.22",
    "expo-asset": "~58.0.20",
    "expo-camera": "~58.0.14",
    "expo-clipboard": "~58.0.4",
    "expo-constants": "~58.0.14",
    "expo-crypto": "~58.0.7",
    "expo-device": "~58.0.5",
    "expo-file-system": "~58.0.13",
    "expo-font": "~58.0.11",
    "expo-glass-effect": "~58.0.5",
    "expo-image": "~58.0.18",
    "expo-image-picker": "~58.0.10",
    "expo-linking": "~58.0.15",
    "expo-router": "~58.0.29",
    "expo-screen-capture": "~58.0.6",
    "expo-secure-store": "~58.0.2",
    "expo-sharing": "~58.0.23",
    "expo-splash-screen": "~58.0.12",
    "expo-sqlite": "~58.0.15",
    "expo-status-bar": "~58.0.4",
    "expo-symbols": "~58.0.4",
    "expo-system-ui": "~58.0.7",
    "expo-web-browser": "~58.0.7",
    "idn-finlogos": "^2.5.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.1",
    "react-native-gesture-handler": "~3.3.0",
    "react-native-reanimated": "4.7.1",
    "react-native-safe-area-context": "~5.10.1",
    "react-native-screens": "~4.30.1",
    "react-native-svg": "15.16.0",
    "react-native-web": "~0.21.4",
    "react-native-worklets": "0.13.0",
    "zod": "^4.6.7",
    "zustand": "^5.0.16"
  },
  "devDependencies": {
    "@testing-library/react-native": "^14.1.0",
    "@types/better-sqlite3": "^9.6.0",
    "@types/jest": "^30.0.0",
    "@types/node": "^26.6.6",
    "@types/react": "~19.3.0",
    "better-sqlite3": "^13.0.3",
    "eslint": "^9.39.5",
    "eslint-config-expo": "^58.0.4",
    "jest": "^30.5.2",
    "jest-expo": "^58.0.13",
    "test-renderer": "^1.3.1",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "expo start",
    "reset-project": "node ./scripts/reset-project.js",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "lint": "expo lint",
    "test": "jest",
    "ai-eval": "jest --config scripts/jest.ai-eval.config.js",
    "gen-card-assets": "node --experimental-strip-types tools/gen-card-assets.ts"
  },
  "jest": {
    "projects": [
      {
        "displayName": "node",
        "preset": "jest-expo",
        "testEnvironment": "node",
        "setupFilesAfterEnv": [
          "<rootDir>/src/i18n/jest-setup.ts"
        ],
        "testMatch": [
          "<rootDir>/src/data/**/*.test.ts",
          "<rootDir>/src/domain/**/*.test.ts",
          "<rootDir>/src/core/**/*.test.ts",
          "<rootDir>/src/features/**/*.test.ts",
          "<rootDir>/src/i18n/**/*.test.ts",
          "<rootDir>/src/theme/**/*.test.ts",
          "<rootDir>/src/dev/**/*.test.ts",
          "<rootDir>/src/__tests__/**/*.test.ts"
        ]
      },
      {
        "displayName": "components",
        "preset": "jest-expo",
        "resolver": "react-native-reanimated/jest/resolver",
        "transformIgnorePatterns": [
          "/node_modules/(?!(.pnpm|react-native|@react-native|@react-native-community|expo|@expo|@expo-google-fonts|react-navigation|@react-navigation|@sentry/react-native|native-base|standard-navigation|@shopify/react-native-skia|idn-finlogos))",
          "/node_modules/react-native-reanimated/plugin/",
          "/node_modules/@react-native/babel-preset/"
        ],
        "setupFiles": [
          "@shopify/react-native-skia/jestSetup.js"
        ],
        "setupFilesAfterEnv": [
          "<rootDir>/src/i18n/jest-setup.ts"
        ],
        "moduleNameMapper": {
          "^@/assets/(.*)$": "<rootDir>/assets/$1",
          "^idn-finlogos/react-native$": "<rootDir>/node_modules/idn-finlogos/dist/react-native/index.js",
          "assets/bank-cards/png/(.+)\\.png$": "<rootDir>/assets/bank-cards/png/$1@3x.png"
        },
        "testMatch": [
          "<rootDir>/src/components/**/*.test.tsx",
          "<rootDir>/src/components/**/*.test.ts",
          "<rootDir>/src/data/**/*.test.tsx",
          "<rootDir>/src/app/**/*.test.tsx",
          "<rootDir>/src/features/**/*.test.tsx"
        ]
      }
    ]
  },
  "private": true
}
