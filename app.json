{
  "expo": {
    "name": "Mono Finance",
    "slug": "mono-finance",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "monofinance",
    "userInterfaceStyle": "dark",
    "androidStatusBar": {
      "barStyle": "light-content"
    },
    "ios": {
      "icon": "./assets/expo.icon"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#0A0A0A",
        "foregroundImage": "./assets/brand/mono-appicon-padded.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.anonymous.monofinance",
      "blockedPermissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.SYSTEM_ALERT_WINDOW",
        "android.permission.USE_BIOMETRIC",
        "android.permission.USE_FINGERPRINT",
        "com.google.android.c2dm.permission.RECEIVE"
      ]
    },
    "web": {
      "output": "server",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0A0A0A",
          "image": "./assets/brand/mono-mark.png",
          "imageWidth": 120
        }
      ],
      "expo-font",
      "expo-sqlite",
      "expo-asset",
      "expo-secure-store",
      [
        "expo-camera",
        {
          "cameraPermission": "MONO memakai kamera hanya untuk memotret struk yang kamu scan. Gambarnya dibaca di perangkat, tidak disimpan, dan tidak dikirim ke mana pun.",
          "microphonePermission": false,
          "recordAudioAndroid": false,
          "barcodeScannerEnabled": false
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "MONO membaca foto struk yang kamu pilih. Gambarnya dibaca di perangkat, tidak disimpan, dan tidak dikirim ke mana pun.",
          "microphonePermission": false
        }
      ],
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "MONO memakai lokasi hanya saat kamu menambah transaksi. Koordinat tetap di perangkat ini; peta di detail transaksi hanya mengunduh data peta untuk perkiraan area."
        }
      ],
      "expo-sharing",
      "react-native-nfc-manager",
      "./plugins/withNfcManagerCompileSdk",
      "./plugins/withNfcLaunch",
      [
        "expo-notifications",
        {
          "icon": "./assets/brand/mono-mark.png",
          "color": "#B8972E",
          "sounds": [],
          "androidMode": "default"
        }
      ],
      "@maplibre/maplibre-react-native",
      "expo-video"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
