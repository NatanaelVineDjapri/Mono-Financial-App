{
  "expo": {
    "name": "Mono Finance",
    "slug": "mono-finance",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "monofinance",
    "userInterfaceStyle": "dark",
    "androidStatusBar": {
      "barStyle": "light-content"
    },
    "ios": {
      "icon": "./assets/expo.icon"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#0A0A0A",
        "foregroundImage": "./assets/brand/mono-appicon-padded.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.anonymous.monofinance"
    },
    "web": {
      "output": "server",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0A0A0A",
          "image": "./assets/brand/mono-mark.png",
          "imageWidth": 120
        }
      ],
      "expo-font",
      "expo-sqlite",
      "expo-asset",
      "expo-secure-store"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
